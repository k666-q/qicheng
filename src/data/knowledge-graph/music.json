    {
      "source": "mus_theory",
      "target": "mus_rhythm",
      "type": "related",
      "reason": "音高与节奏是音乐的两大维度，乐谱上音符的时值记法把两者绑在同一套符号体系里。"
    },
    {
      "source": "mus_theory",
      "target": "mus_harmony",
      "type": "prerequisite",
      "reason": "和弦由音程叠置而成：不懂大小三度，就无法理解大三和弦与小三和弦的差别。"
    },
    {
      "source": "mus_theory",
      "target": "mus_melody_form",
      "type": "prerequisite",
      "reason": "旋律写作建立在音阶与调式之上，曲式分析也要先能读谱认调。"
    },
    {
      "source": "mus_theory",
      "target": "mus_ear",
      "type": "prerequisite",
      "reason": "视唱练耳是把乐理知识内化成听觉本能：先知道音程的概念，再练出听辨它的耳朵。"
    },
    {
      "source": "mus_theory",
      "target": "mus_piano",
      "type": "prerequisite",
      "reason": "钢琴键盘是乐理的实体化：认识音名和调号后，琴键位置与指法才有意义。"
    },
    {
      "source": "mus_theory",
      "target": "mus_guitar",
      "type": "prerequisite",
      "reason": "吉他和弦图、变调夹的使用都以基础乐理为前提，懂乐理才能举一反三换调弹唱。"
    },
    {
      "source": "mus_rhythm",
      "target": "mus_guitar",
      "type": "related",
      "reason": "扫弦型就是节奏型：吉他弹唱的律动感全靠对拍子与切分的把握。"
    },
    {
      "source": "mus_harmony",
      "target": "mus_composition",
      "type": "prerequisite",
      "reason": "编配和声是作曲的核心工序：和弦进行决定了整首歌的情绪走向。"
    },
    {
      "source": "mus_melody_form",
      "target": "mus_composition",
      "type": "prerequisite",
      "reason": "写歌需要先懂歌的结构：动机如何发展成乐句、主副歌如何制造对比与记忆点。"
    },
    {
      "source": "mus_ear",
      "target": "mus_composition",
      "type": "related",
      "reason": "好耳朵是作曲的质检员：能听出和声错误与旋律走音，才能不断修正自己的作品。"
    },
    {
      "source": "mus_composition",
      "target": "mus_production",
      "type": "prerequisite",
      "reason": "制作的对象是编曲完成的作品：先有分轨与配器方案，录音混音才有施展空间。"
    },
    {
      "source": "mus_history_classical",
      "target": "mus_harmony",
      "type": "related",
      "reason": "功能和声体系正是在巴洛克到浪漫主义时期发展成熟的，听古典作品就是读和声史。"
    },
    {
      "source": "mus_history_pop",
      "target": "mus_production",
      "type": "related",
      "reason": "流行乐风格的演变与录音技术互相成就：从磁带到数字工作站，制作方式定义了时代音色。"
    },
    {
      "source": "mus_history_classical",
      "target": "mus_history_pop",
      "type": "related",
      "reason": "流行音乐的和声语言与配器手法大量借鉴古典传统，两段历史是同一条河的上下游。"
    },
    {
      "source": "mus_piano",
      "target": "mus_composition",
      "type": "related",
      "reason": "钢琴是作曲家的草稿纸：88个键覆盖全部音域，试和弦、写旋律都离不开它。"
    }
  ]
