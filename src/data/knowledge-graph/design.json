  "edges": [
    {
      "source": "design_principles",
      "target": "design_color",
      "type": "prerequisite",
      "reason": "色彩运用的前提是理解对比和层级原则：配色方案本身就是对比原则的颜色维度应用。"
    },
    {
      "source": "design_principles",
      "target": "design_typography",
      "type": "prerequisite",
      "reason": "字体排版的字号层级、对齐方式直接来自设计四大原则（对齐、对比、重复、亲密性）。"
    },
    {
      "source": "design_principles",
      "target": "design_layout",
      "type": "prerequisite",
      "reason": "版式设计是四大原则在空间上的综合运用：网格是对齐的系统化，留白是亲密性的反面。"
    },
    {
      "source": "design_color",
      "target": "design_ui",
      "type": "related",
      "reason": "UI设计中按钮状态、主题色、反馈色等都依赖色彩理论：主色传达品牌，功能色引导操作。"
    },
    {
      "source": "design_typography",
      "target": "design_ui",
      "type": "related",
      "reason": "界面中90%的信息通过文字传达，字体层级决定了用户的阅读顺序和信息获取效率。"
    },
    {
      "source": "design_layout",
      "target": "design_ui",
      "type": "prerequisite",
      "reason": "UI界面的组件排列遵循网格系统，卡片布局、响应式断点都是版式理论在屏幕上的直接应用。"
    },
    {
      "source": "design_tool",
      "target": "design_ui",
      "type": "prerequisite",
      "reason": "UI设计需要在Figma等工具中输出高保真原型，不会工具就无法将设计想法转化为可交付物。"
    },
    {
      "source": "design_ui",
      "target": "design_ux",
      "type": "prerequisite",
      "reason": "用户体验建立在界面设计之上：先有可用的界面方案，才能进行用户研究和可用性测试来优化体验。"
    },
    {
      "source": "design_ui",
      "target": "design_interaction",
      "type": "prerequisite",
      "reason": "交互设计为界面注入行为逻辑：按钮的悬停、按下、禁用状态都要先有静态界面作为载体。"
    },
    {
      "source": "design_interaction",
      "target": "design_ux",
      "type": "related",
      "reason": "交互流程的顺畅度直接决定体验好坏：可用性测试中暴露的问题大多出在交互环节。"
    },
    {
      "source": "design_color",
      "target": "design_brand",
      "type": "prerequisite",
      "reason": "品牌色是品牌识别的核心资产：可口可乐红、蒂芙尼蓝的选择和延展全靠色彩理论支撑。"
    },
    {
      "source": "design_typography",
      "target": "design_brand",
      "type": "related",
      "reason": "品牌专属字体传达品牌性格：衬线体显经典，无衬线体显现代，字体选择是品牌调性的一半。"
    },
    {
      "source": "design_ui",
      "target": "design_motion",
      "type": "prerequisite",
      "reason": "动效是界面状态之间的过渡：先定义好静态界面的各个状态，才能设计它们之间的动画衔接。"
    },
    {
      "source": "design_motion",
      "target": "design_ux",
      "type": "related",
      "reason": "恰当的动效提升体验，过度的动效拖慢操作：动效时长与缓动的拿捏是体验打磨的细节功夫。"
    },
    {
      "source": "design_history",
      "target": "design_principles",
      "type": "related",
      "reason": "今天的设计原则源自历史沉淀：网格系统来自瑞士平面风格，'少即是多'来自现代主义运动。"
    },
    {
      "source": "design_history",
      "target": "design_brand",
      "type": "related",
      "reason": "经典品牌案例是设计史的活教材：理解不同流派的视觉语言能为品牌定位提供风格参照。"
    },
    {
      "source": "design_tool",
      "target": "design_icon_illustration",
      "type": "prerequisite",
      "reason": "图标和插画依赖矢量工具：钢笔工具、布尔运算是绘制规整图形的基本功。"
    },
    {
      "source": "design_icon_illustration",
      "target": "design_ui",
      "type": "related",
      "reason": "图标是界面的'文字'：导航栏、功能入口都靠图标传达含义，风格统一的图标库是 UI 的标配。"
    },
    {
      "source": "design_ui",
      "target": "design_system",
      "type": "prerequisite",
      "reason": "设计系统是 UI 设计的规模化：先做好单个界面的组件，再沉淀为可复用的规范和组件库。"
    },
    {
      "source": "design_typography",
      "target": "design_system",
      "type": "related",
      "reason": "字阶与行高规范是设计系统的基础层：字体令牌的定义直接沿用排版理论的层级体系。"
    },
    {
      "source": "design_layout",
      "target": "design_graphic",
      "type": "prerequisite",
      "reason": "海报设计是版式理论的集中演练：视觉动线引导读者先看标题再看正文，网格保证信息有序。"
    },
    {
      "source": "design_graphic",
      "target": "design_brand",
      "type": "related",
      "reason": "品牌物料（海报、包装、宣传册）是品牌视觉落地的主要载体，两者在实战中密不可分。"
    }
  ]
}
