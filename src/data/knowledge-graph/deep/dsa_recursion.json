    },
    {
      "id": "rec_hanoi",
      "subjectId": "programming",
      "parentId": "dsa_recursion",
      "name": "汉诺塔",
      "plain_name": "借中间柱把整摞盘子搬过去",
      "description": "把 n 个盘从 A 经 B 搬到 C：先递归把上面 n-1 个盘从 A 经 C 移到 B，再把最大盘从 A 移到 C，最后递归把 n-1 个盘从 B 经 A 移到 C。动画展示三根柱子上盘子按此递归顺序逐个移动。",
      "difficulty": 6,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["汉诺塔", "递归", "辅助柱", "盘子移动", "2ⁿ-1"],
