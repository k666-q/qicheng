    {
      "id": "rec_divide_conquer",
      "subjectId": "programming",
      "parentId": "dsa_recursion",
      "name": "分治三步法",
      "plain_name": "分解、解决、再合并",
      "description": "分治把大问题拆成同类子问题：第一步分解(把规模 n 切成两半)，第二步解决(递归处理每一半直到子问题足够小)，第三步合并(把子结果拼成原问题答案)。动画用一棵不断二分再向上汇聚的树展示三个阶段。",
      "difficulty": 5,
      "depth": 2,
