    },
    {
      "id": "app_http_cache",
      "subjectId": "programming",
      "parentId": "net_application",
      "name": "HTTP缓存机制",
      "plain_name": "没变就用本地，省得重新下载",
      "description": "浏览器首次请求时把响应连同ETag和过期时间存入缓存；再次访问若未过期直接用本地副本，若过期则带If-None-Match询问，服务器内容没变就回304让浏览器复用缓存。动画显示缓存命中走捷径、304跳过下载正文。",
      "difficulty": 6,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["HTTP缓存", "ETag", "304", "缓存命中", "条件请求"],
      "prerequisites": ["app_http_req_resp"],
      "cognition_tags": ["system", "logic"]
    }
  ],
