    },
    {
      "id": "app_https_tls",
      "subjectId": "programming",
      "parentId": "net_application",
      "name": "HTTPS的TLS握手",
      "plain_name": "先交换密钥再加密通信",
      "description": "客户端发ClientHello，服务器回ServerHello并送上证书与公钥，客户端验证证书后用公钥加密一个会话密钥发回，双方此后用该对称密钥加密数据。动画显示握手箭头往返、证书校验打勾、最后建立绿色加密通道。",
      "difficulty": 8,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["HTTPS", "TLS握手", "证书", "公钥", "会话密钥"],
