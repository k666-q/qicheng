      "id": "app_dns_recursive",
      "subjectId": "programming",
      "parentId": "net_application",
      "name": "DNS递归查询过程",
      "plain_name": "把域名一级一级问成IP地址",
      "description": "本地DNS服务器替主机依次询问：先问根服务器得到顶级域（.com）服务器地址，再问.com得到权威服务器地址，最后权威服务器返回域名对应IP。动画显示请求箭头逐级向上跳转、再把IP一路返回给主机。",
      "difficulty": 6,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["DNS", "递归查询", "根服务器", "权威服务器", "域名解析"],
      "prerequisites": [],
      "cognition_tags": ["system", "logic"]
    },
    {
      "id": "app_http_req_resp",
      "subjectId": "programming",
      "parentId": "net_application",
      "name": "HTTP请求响应",
      "plain_name": "浏览器问，服务器答",
      "description": "浏览器发送一条HTTP请求（方法GET、路径、请求头），服务器处理后回一条响应（状态码200、响应头、HTML正文）。动画显示左侧请求报文卡片飞向服务器、右侧响应报文卡片飞回并逐行展开各字段。",
      "difficulty": 4,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["HTTP", "请求", "响应", "状态码", "报文"],
      "prerequisites": ["app_dns_recursive"],
