    {
      "id": "tree_avl_rotation",
      "subjectId": "programming",
      "parentId": "dsa_tree",
      "name": "AVL树的旋转平衡",
      "plain_name": "树歪了就转一下扶正",
      "description": "AVL树插入后若某节点左右子树高度差超过1就失衡。动画演示 LL 型失衡做单次右旋：把失衡节点向右下转、其左孩子上提成为新根，并重接子树。展示旋转前后高度差恢复到不超过1。",
