      "cognition_tags": ["logic", "abstract"]
    },
    {
      "id": "search_hash_open_addressing",
      "subjectId": "programming",
      "parentId": "dsa_searching",
      "name": "哈希冲突的开放寻址",
      "plain_name": "撞桶了就往后找空位",
      "description": "开放寻址不另挂链表，冲突时按探测序列(如线性探测 index+1)在表内向后寻找下一个空桶放入。动画演示元素撞上已占用的桶后，沿数组逐格探测直到找到空位坐下；查找时同样沿探测路径比较。",
      "difficulty": 5,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["哈希冲突", "开放寻址", "线性探测", "探测序列", "空桶"],
