    {
      "id": "proc_context_switch",
      "subjectId": "programming",
      "parentId": "os_process",
      "name": "上下文切换过程",
      "plain_name": "CPU从一个进程切到另一个进程",
      "description": "当切换进程时，CPU 把当前进程的寄存器和程序计数器保存到它的PCB，再从下一个进程的PCB加载寄存器和PC，恢复其执行现场。动画展示寄存器内容从进程A的PCB存出、再从进程B的PCB存入CPU的过程。",
