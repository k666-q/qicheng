    {
      "id": "sync_deadlock_conditions",
      "subjectId": "programming",
      "parentId": "os_sync",
      "name": "死锁的四个必要条件",
      "plain_name": "互相卡住谁也不让步的僵局",
      "description": "死锁需同时满足互斥、占有并等待、不可剥夺、循环等待四个条件。动画展示两个进程各持有一个资源又申请对方持有的资源，形成一个首尾相接的环形等待图，谁也无法继续。",
      "difficulty": 6,
      "depth": 2,
