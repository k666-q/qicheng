    {
      "id": "sync_bankers",
      "subjectId": "programming",
      "parentId": "os_sync",
      "name": "银行家算法避免死锁",
      "plain_name": "分配前先试算，确保系统仍安全",
      "description": "进程申请资源时，银行家算法先假设分配，再检查是否存在一个能让所有进程依次跑完的安全序列；若存在才真正分配，否则让进程等待。动画展示可用资源、已分配、还需求的表格，逐步寻找安全序列的过程。",
      "difficulty": 8,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["银行家算法", "安全序列", "避免死锁", "资源分配", "安全状态"],
