    {
      "id": "sync_semaphore_pv",
      "subjectId": "programming",
      "parentId": "os_sync",
      "name": "信号量的P/V操作",
      "plain_name": "用计数器管理资源的拿与还",
      "description": "信号量是一个整数计数器，P操作（申请）把它减1，若小于0则进程阻塞等待；V操作（释放）把它加1，若有等待进程则唤醒一个。动画展示计数值随P/V增减、进程在阻塞队列里被加入和唤醒的过程。",
      "difficulty": 6,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["信号量", "P操作", "V操作", "计数器", "阻塞队列"],
      "prerequisites": ["sync_critical_section"],
      "cognition_tags": ["abstract", "system"]
    },
    {
      "id": "sync_producer_consumer",
      "subjectId": "programming",
      "parentId": "os_sync",
      "name": "生产者消费者问题",
      "plain_name": "一边往缓冲区放，一边从里面取",
      "description": "生产者向有限缓冲区放数据、消费者取数据，用空位信号量和满位信号量协调：缓冲区满时生产者阻塞，空时消费者阻塞，互斥信号量保护缓冲区。动画展示生产者填格子、消费者取格子，两个计数器此消彼长的过程。",
      "difficulty": 7,
      "depth": 2,
      "hasChildren": false,
