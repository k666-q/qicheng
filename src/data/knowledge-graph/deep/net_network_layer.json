    {
      "id": "ip_longest_prefix",
      "subjectId": "programming",
      "parentId": "net_network_layer",
      "name": "路由表最长前缀匹配",
      "plain_name": "选匹配位数最多的那条路由",
      "description": "路由器收到目的IP后，逐条与路由表中的网络前缀比对，可能多条都匹配，则选择匹配比特位最长（最具体）的那条来转发。动画高亮多条候选项，比较各自掩码长度后选中最长的并指向其出口。",
      "difficulty": 7,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["路由表", "最长前缀匹配", "前缀", "掩码长度", "转发"],
