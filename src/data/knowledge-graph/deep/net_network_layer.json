    },
    {
      "id": "ip_subnetting",
      "subjectId": "programming",
      "parentId": "net_network_layer",
      "name": "子网划分",
      "plain_name": "借主机位把大网切成小网",
      "description": "从主机位中借出几位作为子网号，把一个大网络切成多个小子网。动画显示一条地址段被向右移动的掩码分界线切成2、4、8个等长子块，并标出每个子网的地址范围和可用主机数。",
      "difficulty": 7,
