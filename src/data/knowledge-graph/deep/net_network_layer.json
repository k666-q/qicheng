      "id": "ip_address_mask",
      "subjectId": "programming",
      "parentId": "net_network_layer",
      "name": "IP地址与子网掩码",
      "plain_name": "地址分网络号和主机号两半",
      "description": "把32位IP地址和子网掩码上下对齐，掩码中连续的1对应网络号、0对应主机号。动画演示IP与掩码逐位做按位与运算，得到网络地址，直观看出地址被切成网络部分和主机部分。",
      "difficulty": 5,
      "depth": 2,
      "hasChildren": false,
