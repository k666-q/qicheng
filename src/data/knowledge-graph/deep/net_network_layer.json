    },
    {
      "id": "ip_arp",
      "subjectId": "programming",
      "parentId": "net_network_layer",
      "name": "ARP地址解析过程",
      "plain_name": "知道IP问出对应的MAC地址",
      "description": "主机要发数据却只知道对方IP不知MAC，于是广播一条ARP请求“谁是这个IP”，目标主机单播回ARP应答告知自己的MAC，发送方缓存映射。动画显示广播气泡扩散、目标回单播箭头、ARP表新增一行。",
      "difficulty": 5,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["ARP", "地址解析", "广播请求", "单播应答", "ARP缓存"],
      "prerequisites": ["ip_address_mask"],
      "cognition_tags": ["logic", "system"]
    },
    {
      "id": "ip_forwarding",
      "subjectId": "programming",
      "parentId": "net_network_layer",
      "name": "IP分组的转发",
      "plain_name": "路由器一跳一跳接力送包",
      "description": "IP包到达路由器后，路由器查路由表决定下一跳，把TTL减1、重算校验和，再封装成新的链路帧从对应接口发出。动画显示包在多个路由器节点间逐跳前进、TTL数字每跳递减直到抵达目的网络。",
      "difficulty": 6,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["IP转发", "下一跳", "TTL", "路由器", "逐跳"],
      "prerequisites": ["ip_longest_prefix", "ip_arp"],
      "cognition_tags": ["system", "logic"]
    }
