    {
      "id": "lin_linkedlist_insert_delete",
      "subjectId": "programming",
      "parentId": "dsa_linear",
      "name": "链表的插入删除",
      "plain_name": "改指针就能插入或摘掉节点",
      "description": "链表节点用箭头表示 next 指针。插入时新节点的 next 指向后继、前驱的 next 指向新节点；删除时让前驱 next 越过被删节点直接指向其后继。动画高亮被修改的两三条指针，体现 O(1) 的指针重连。",
      "difficulty": 4,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["链表", "节点", "指针重连", "插入", "删除"],
