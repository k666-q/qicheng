    {
      "id": "lin_stack_push_pop",
      "subjectId": "programming",
      "parentId": "dsa_linear",
      "name": "栈的压入弹出",
      "plain_name": "后进先出，只能从顶操作",
      "description": "栈是一摞盘子，top 指针指向栈顶。压入(push)时新元素放到 top 之上、top 上移；弹出(pop)时取走栈顶元素、top 下移。动画演示连续 push 三个元素再 pop，体现后进先出(LIFO)。",
      "difficulty": 3,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["栈", "LIFO", "压入", "弹出", "栈顶指针"],
      "prerequisites": ["lin_array_access"],
      "cognition_tags": ["logic", "abstract"]
    },
    {
      "id": "lin_queue_enqueue_dequeue",
      "subjectId": "programming",
      "parentId": "dsa_linear",
      "name": "队列的入队出队",
      "plain_name": "先进先出，排队办业务",
      "description": "队列像排队的人群，rear 指针在队尾、front 指针在队头。入队(enqueue)在 rear 端添加元素、rear 后移；出队(dequeue)从 front 端取走元素、front 后移。动画演示元素从右进、从左出，体现先进先出(FIFO)。",
      "difficulty": 3,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["队列", "FIFO", "入队", "出队", "队头队尾"],
      "prerequisites": ["lin_stack_push_pop"],
      "cognition_tags": ["logic", "abstract"]
    },
