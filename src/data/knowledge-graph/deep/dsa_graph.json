    {
      "id": "graph_adjacency_list",
      "subjectId": "programming",
      "parentId": "dsa_graph",
      "name": "图的邻接表表示",
      "plain_name": "每个顶点挂一串它的邻居",
      "description": "邻接表用一个数组存放所有顶点，每个顶点后面挂一条链表记录与它相连的邻居。动画演示遍历一条边 (u,v) 时把 v 追加到 u 的链表尾部，逐条边构建出整张表，对比邻接矩阵的稀疏省空间优势。",
      "difficulty": 4,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["图", "邻接表", "顶点", "边", "链表存储"],
