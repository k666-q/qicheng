    {
      "id": "graph_dijkstra_relax",
      "subjectId": "programming",
      "parentId": "dsa_graph",
      "name": "Dijkstra最短路径的松弛",
      "plain_name": "不断用更短的路更新距离",
      "description": "每个顶点维护一个当前最短距离估计。每轮从未确定顶点中取出距离最小者锁定，再对它的每条出边做松弛：若 dist[u]+边权 < dist[v] 就更新 dist[v]。动画高亮被取出的顶点和被松弛变小的邻居距离值。",
      "difficulty": 7,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["Dijkstra", "最短路径", "松弛", "贪心", "优先队列"],
      "prerequisites": ["graph_bfs"],
