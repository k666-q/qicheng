      "cognition_tags": ["logic", "abstract"]
    },
    {
      "id": "graph_dfs",
      "subjectId": "programming",
      "parentId": "dsa_graph",
      "name": "DFS深度优先遍历",
      "plain_name": "一条路走到底再回头",
      "description": "从起点沿一条路径不断深入，每到一个顶点就标记并递归访问其第一个未访问邻居，走到死路再回溯换下一条分支。动画用栈展示递归过程，高亮当前路径并在回溯时弹栈退回上一个顶点。",
      "difficulty": 5,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["DFS", "深度优先", "递归", "栈", "回溯"],
      "prerequisites": ["graph_adjacency_list"],
