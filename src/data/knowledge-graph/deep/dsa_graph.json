    },
    {
      "id": "graph_bfs",
      "subjectId": "programming",
      "parentId": "dsa_graph",
      "name": "BFS广度优先遍历",
      "plain_name": "一层一层像水波扩散",
      "description": "从起点出发，用队列管理待访问顶点：先把起点入队并标记，每次出队一个顶点就把它所有未访问邻居入队并标记。动画展示顶点像水波一圈圈被染色，配合右侧队列的入队出队，体现按层扩展。",
      "difficulty": 5,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["BFS", "广度优先", "队列", "按层扩展", "访问标记"],
