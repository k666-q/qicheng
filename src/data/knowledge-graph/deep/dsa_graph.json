    },
    {
      "id": "graph_mst_prim_kruskal",
      "subjectId": "programming",
      "parentId": "dsa_graph",
      "name": "最小生成树Prim与Kruskal",
      "plain_name": "用最便宜的边连通所有点",
      "description": "Prim 从一个顶点出发，每次选连接已选集合与外部的最小边并入树；Kruskal 则把所有边按权重排序，依次选不构成环的边(用并查集判环)。动画分别高亮被选中的边逐步生长成一棵覆盖全部顶点的最小生成树。",
      "difficulty": 7,
      "depth": 2,
      "hasChildren": false,
      "keywords": ["最小生成树", "Prim", "Kruskal", "贪心", "并查集"],
      "prerequisites": ["graph_dijkstra_relax"],
      "cognition_tags": ["logic", "abstract"]
    }
