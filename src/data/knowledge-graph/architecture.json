  "edges": [
    {
      "source": "arch_intro",
      "target": "arch_drawing",
      "type": "prerequisite",
      "reason": "理解建筑的基本议题后，制图是把空间想法落到纸面的第一项专业技能。"
    },
    {
      "source": "arch_intro",
      "target": "arch_space",
      "type": "prerequisite",
      "reason": "空间与形态训练直接展开导论中'建筑即空间艺术'的核心命题。"
    },
    {
      "source": "arch_drawing",
      "target": "arch_space",
      "type": "prerequisite",
      "reason": "空间方案要用平立剖图纸推敲和表达：不会制图，空间想象只能停在脑子里。"
    },
    {
      "source": "arch_space",
      "target": "arch_interior",
      "type": "prerequisite",
      "reason": "室内设计是空间组织在小尺度的精细化：动线、尺度感的功夫直接沿用。"
    },
    {
      "source": "arch_structure",
      "target": "arch_space",
      "type": "related",
      "reason": "结构决定空间的可能性：大跨度结构才撑得起无柱大厅，悬挑才有飘浮的阳台。"
    },
    {
      "source": "arch_materials",
      "target": "arch_structure",
      "type": "prerequisite",
      "reason": "结构选型离不开材料特性：混凝土抗压、钢材抗拉，材料性格决定结构形式。"
    },
    {
      "source": "arch_materials",
      "target": "arch_interior",
      "type": "related",
      "reason": "室内的质感与造价大半由材料决定：木的温润、石的冷峻都是材料知识的应用。"
    },
    {
      "source": "arch_history_west",
      "target": "arch_space",
      "type": "related",
      "reason": "万神庙的穹顶、流水别墅的流动空间都是经典空间范本，历史是设计的素材库。"
    },
    {
      "source": "arch_history_china",
      "target": "arch_landscape",
      "type": "related",
      "reason": "苏州园林'移步换景'的造园智慧至今仍是景观设计的东方教科书。"
    },
    {
      "source": "arch_history_west",
      "target": "arch_history_china",
      "type": "related",
      "reason": "石构与木构两条传统对照着看，更能理解建筑形式背后的文化与技术选择。"
    },
    {
      "source": "arch_intro",
      "target": "arch_urban",
      "type": "prerequisite",
      "reason": "城市是放大的建筑议题：先理解单体建筑与人的关系，再扩展到街区和城市尺度。"
    },
    {
      "source": "arch_urban",
      "target": "arch_landscape",
      "type": "related",
      "reason": "城市的公园绿道系统由规划定框架、景观做深化，两个专业在公共空间上交汇。"
    },
    {
      "source": "arch_structure",
      "target": "arch_green",
      "type": "related",
      "reason": "绿色建筑常用木结构减碳、用结构遮阳一体化设计，结构与节能策略互相牵动。"
    },
    {
      "source": "arch_materials",
      "target": "arch_green",
      "type": "prerequisite",
      "reason": "建材的保温性能与隐含碳排是绿色建筑的核心账本，选材即选能耗。"
    },
    {
      "source": "arch_space",
      "target": "arch_green",
      "type": "related",
      "reason": "被动式设计靠空间布局实现：朝向、进深、天井通风都是用空间手段省能源。"
    }
  ]
